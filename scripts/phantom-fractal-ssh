#!/bin/sh
set -eu

# Safe-quoted SSH shim for running phantom-fractal on a remote host.
# Every argument is single-quoted so shell metacharacters never execute
# remotely and arrive at the remote binary as single literal argv tokens.
# The remote login shell must be POSIX (sh, bash, zsh, dash, ksh);
# backslashes are refused so fish cannot reopen single quotes.
#
# Environment:
#   PHANTOM_SSH_HOST         Required remote SSH target host.
#   PHANTOM_REMOTE_BIN       Remote binary path or name (default: phantom-fractal).
#   PHANTOM_REMOTE_DATA_DIR  Optional remote PHANTOM_FRACTAL_DATA directory.
#   PHANTOM_REMOTE_REPO      Optional allowed remote repo root path.
#   PHANTOM_LOCAL_REPO       Optional local repo root path mapped to PHANTOM_REMOTE_REPO.

die() {
  printf '%s\n' "phantom-fractal-ssh: $1" >&2
  exit 1
}

reject_backslash() {
  case $1 in
    *\\*)
      die "refused $2 containing '\\' (POSIX remote login shell required)"
      ;;
  esac
}

sh_quote() {
  _sq_in=$1
  _sq_out="'"
  while :; do
    case $_sq_in in
      *"'"*)
        _sq_head=${_sq_in%%"'"*}
        _sq_out="$_sq_out$_sq_head'\\''"
        _sq_in=${_sq_in#*"'"}
        ;;
      *)
        _sq_out="$_sq_out$_sq_in'"
        break
        ;;
    esac
  done
  printf '%s' "$_sq_out"
}

strip_trailing_slash() {
  _p=$1
  while [ "${#_p}" -gt 1 ]; do
    case $_p in
      */) _p=${_p%/} ;;
      *) break ;;
    esac
  done
  printf '%s' "$_p"
}

has_parent_traversal() {
  case $1 in
    ..|../*|*/..|*/../*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

probe_local_dir=""
_mapped_repo=""

validate_and_map_repo() {
  _repo=$1
  _mapped_repo=""
  if [ -z "$_repo" ]; then
    die "refused empty --repo path"
  fi
  if has_parent_traversal "$_repo"; then
    die "refused --repo path containing '..'"
  fi
  case $_repo in
    /*)
      _local=""
      _remote=""
      if [ -n "${PHANTOM_LOCAL_REPO-}" ]; then
        _local=$(strip_trailing_slash "$PHANTOM_LOCAL_REPO")
      fi
      if [ -n "${PHANTOM_REMOTE_REPO-}" ]; then
        _remote=$(strip_trailing_slash "$PHANTOM_REMOTE_REPO")
      fi
      if [ -n "$_local" ] && [ -n "$_remote" ]; then
        if [ "$_repo" = "$_local" ]; then
          probe_local_dir=$_local
          _mapped_repo=$_remote
          return 0
        fi
        case $_repo in
          "$_local"/*)
            probe_local_dir=$_local
            _mapped_repo="$_remote/${_repo#"$_local"/}"
            return 0
            ;;
        esac
      fi
      if [ -n "$_remote" ]; then
        if [ "$_repo" = "$_remote" ]; then
          if [ -n "$_local" ]; then
            probe_local_dir=$_local
          fi
          _mapped_repo=$_repo
          return 0
        fi
        case $_repo in
          "$_remote"/*)
            if [ -n "$_local" ]; then
              probe_local_dir=$_local
            fi
            _mapped_repo=$_repo
            return 0
            ;;
        esac
      fi
      die "refused unmapped local absolute --repo path; set PHANTOM_REMOTE_REPO or pass a remote path"
      ;;
    *)
      _mapped_repo=$_repo
      ;;
  esac
}

expected_head=""
expected_dirty=""

probe_local_repo() {
  _dir=$1
  expected_head=""
  expected_dirty="1"
  if ! command -v git >/dev/null 2>&1; then
    return 0
  fi
  if ! _head=$(
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
      GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
    git -C "$_dir" -c core.fsmonitor=false -c core.hooksPath=/dev/null rev-parse HEAD 2>/dev/null
  ); then
    return 0
  fi
  case $_head in
    *[!0-9a-f]*)
      return 0
      ;;
  esac
  if [ "${#_head}" -ne 40 ] && [ "${#_head}" -ne 64 ]; then
    return 0
  fi
  if ! _status=$(
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
      GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
    git -C "$_dir" -c core.fsmonitor=false -c core.hooksPath=/dev/null status --porcelain=v1 --untracked-files=normal 2>/dev/null
  ); then
    expected_head=$_head
    return 0
  fi
  expected_head=$_head
  if [ -z "$_status" ]; then
    expected_dirty="0"
  fi
}

ssh_host=${PHANTOM_SSH_HOST-}
if [ -z "$ssh_host" ]; then
  die "PHANTOM_SSH_HOST is required"
fi

remote_bin=${PHANTOM_REMOTE_BIN-phantom-fractal}
if [ -z "$remote_bin" ]; then
  die "PHANTOM_REMOTE_BIN must not be empty"
fi
reject_backslash "$remote_bin" "PHANTOM_REMOTE_BIN"

args_cmd=""
after_double_dash=0
expect_repo_val=0
for arg in "$@"; do
  reject_backslash "$arg" "argument"
  if [ "$expect_repo_val" -eq 1 ]; then
    validate_and_map_repo "$arg"
    reject_backslash "$_mapped_repo" "--repo path"
    args_cmd="$args_cmd $(sh_quote "$_mapped_repo")"
    expect_repo_val=0
    continue
  fi
  if [ "$after_double_dash" -eq 0 ]; then
    case $arg in
      --)
        after_double_dash=1
        args_cmd="$args_cmd '--'"
        continue
        ;;
      --repo)
        expect_repo_val=1
        args_cmd="$args_cmd '--repo'"
        continue
        ;;
      --repo=*)
        _val=${arg#--repo=}
        validate_and_map_repo "$_val"
        reject_backslash "$_mapped_repo" "--repo path"
        args_cmd="$args_cmd $(sh_quote "--repo=$_mapped_repo")"
        continue
        ;;
    esac
  fi
  args_cmd="$args_cmd $(sh_quote "$arg")"
done

if [ "$expect_repo_val" -eq 1 ]; then
  die "missing path after --repo"
fi

env_prefix=""
if [ -n "${PHANTOM_REMOTE_DATA_DIR-}" ]; then
  reject_backslash "$PHANTOM_REMOTE_DATA_DIR" "PHANTOM_REMOTE_DATA_DIR"
  env_prefix="PHANTOM_FRACTAL_DATA=$(sh_quote "$PHANTOM_REMOTE_DATA_DIR") "
fi
if [ -n "$probe_local_dir" ]; then
  probe_local_repo "$probe_local_dir"
  if [ -n "$expected_head" ]; then
    env_prefix="${env_prefix}PHANTOM_EXPECTED_HEAD=$(sh_quote "$expected_head") "
  fi
  env_prefix="${env_prefix}PHANTOM_EXPECTED_DIRTY=$(sh_quote "$expected_dirty") "
fi

remote_cmd="${env_prefix}exec $(sh_quote "$remote_bin")$args_cmd"
exec ssh -o BatchMode=yes -- "$ssh_host" "$remote_cmd"
